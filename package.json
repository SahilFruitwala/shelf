{
  "name": "tracker",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:push:prod": "ALLOW_REMOTE_DB=1 drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "db:studio:prod": "ALLOW_REMOTE_DB=1 drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:purge": "tsx scripts/purge-deleted-users.ts"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.4.21",
    "@fontsource-variable/schibsted-grotesk": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@libsql/client": "^0.17.4",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "@types/leaflet": "^1.9.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "hash-wasm": "^4.12.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "motion": "^12.42.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@clerk/backend": "^3.12.0",
    "@tailwindcss/typography": "^0.5.16",
